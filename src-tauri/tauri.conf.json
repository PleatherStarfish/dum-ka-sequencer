{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dum-Ka",
  "version": "0.1.0",
  "identifier": "io.github.pleatherstarfish.dumka",
  "build": {
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "pnpm build"
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dum-Ka",
        "width": 900,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
